{
  "cli": {
    "version": "27.9.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "preview" }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" }
    }
  },
  "submit": {
    "production": {}
  }
}
