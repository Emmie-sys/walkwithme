PORT=4000
HOST=0.0.0.0
DATABASE_PATH=./backend/data/walkwithme.sqlite
JWT_SECRET=replace-with-a-long-random-development-secret
STUDENT_EMAIL_DOMAINS=gu.ac.ug
ALLOW_DEMO_LOGIN=true
