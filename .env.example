EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Local OTP only. Production requests are rejected until an approved SMS adapter is configured.
PHONE_OTP_DEVELOPMENT=true
